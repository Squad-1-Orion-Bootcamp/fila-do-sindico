# Copie para .env (que não vai para o Git) e preencha.
# Em stage e prod, as mesmas variáveis ficam no painel de cada serviço do Render (veja o README).

# Supabase. No local, fora do Docker: http://127.0.0.1:54321 (o docker compose já define o
# endereço de dentro do container). Em stage e prod: a URL do projeto do Supabase do ambiente.
SUPABASE_URL=http://127.0.0.1:54321

# Chave secreta do Supabase (sb_secret_...): o webhook lê a ocorrência e grava a classificação
# com ela. No local, a "Secret key" do `npx supabase status`; na nuvem, Project Settings → API
# Keys. Nunca no front nem no repositório.
SUPABASE_SECRET_KEY=

# Segredo compartilhado com o gatilho do Supabase que chama o POST /webhook.
# Use o mesmo valor cadastrado no Vault do Supabase (ai_webhook_secret).
WEBHOOK_SECRET=

# Chave da API da Gemini (Google AI Studio): o Gemini Decision 1 decide a urgência e a
# categoria. Vazia, o serviço nem chama a Gemini e classifica só pelas regras de palavra-chave.
LLM_API_KEY=

# Opcionais: modelo do Decision 1 e tempo limite da chamada (em segundos). Os valores abaixo
# são os padrões.
LLM_MODELO_DECISAO=gemini-decision-1
LLM_TIMEOUT_SEGUNDOS=3

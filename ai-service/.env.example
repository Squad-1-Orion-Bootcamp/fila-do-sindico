# Copie para .env (que não vai para o Git) e preencha.
# Em produção, as mesmas variáveis ficam no painel do Render (veja o README).

# Supabase. No local, fora do Docker: http://127.0.0.1:54321 (o docker compose já define o
# endereço de dentro do container). Em produção: a URL do projeto do Supabase do ambiente.
SUPABASE_URL=

# Chave service_role do Supabase: o webhook lê a ocorrência e grava a classificação com ela.
# No local, a do `npx supabase status`. Nunca no front nem no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o gatilho do Supabase que chama o POST /webhook.
# Use o mesmo valor cadastrado no Vault do Supabase (ai_webhook_secret).
WEBHOOK_SECRET=

# Chave da API da Gemini (o LLM que classifica as ocorrências).
LLM_API_KEY=
